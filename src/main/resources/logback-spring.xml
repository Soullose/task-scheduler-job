            <charset>UTF-8</charset>
        </encoder>
    </appender> -->

    <!-- 你项目自己的包，按需调 DEBUG -->
    <logger name="com.w3.taskscheduler" level="DEBUG" />

    <!-- Hibernate SQL：DEBUG 打印 SQL，TRACE 打印参数绑定值 -->
    <logger name="org.hibernate.SQL" level="DEBUG" />
    <logger name="org.hibernate.orm.jdbc.bind" level="TRACE" />

    <!-- 全局兜底保持 INFO，避免其他框架刷屏 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <!-- <appender-ref ref="FILE" /> -->
    </root>
</configuration>