<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 控制台：彩色 -->

    <include resource="org/springframework/boot/logging/logback/defaults.xml" />
    <conversionRule conversionWord="color"
        class="com.w3.taskscheduler.logback.TaskSchedulerLogbackColor" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="ch.qos.logback.classic.PatternLayout">
                <pattern>%clr(%d{yyyy-MM-dd HH:mm:ss}){blue} %color(%level) %clr([%thread]){green} %clr(%logger{50}){cyan} %clr(%color(%msg%n))</pattern>
            </layout>
            <charset class="java.nio.charset.Charset">UTF-8</charset>
        </encoder>
    </appender>

